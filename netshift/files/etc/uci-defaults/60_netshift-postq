# The lines of the profile whose value the config does not have: a `set` of a
# missing option or section, every `add_list` of a list option that is missing.
missing_only() {
    local line cmd rest key filled=" "

    while IFS= read -r line; do
        case "$line" in "" | "#"*) continue ;; esac
        cmd="${line%% *}"
        rest="${line#* }"
        key="${rest%%=*}"
        case "$cmd" in
        set)
            uci -q get "$key" > /dev/null || printf '%s\n' "$line"
            ;;
        add_list)
            case "$filled" in
            *" $key "*) printf '%s\n' "$line" ;;
            *)
                if ! uci -q get "$key" > /dev/null; then
                    filled="$filled$key "
                    printf '%s\n' "$line"
                fi
                ;;
            esac
            ;;
        esac
    done
}

if [ "$(uci -q get netshift.settings.postq_profile)" != "1" ]; then
    subs="$(uci -q get netshift.main.subscription_url)"

    # Sections other than the profile's own would route on their own and are
    # not shown in the simplified UI.
    for s in $(uci -q show netshift | sed -n "s/^netshift\.\([^.=]*\)=section$/\1/p"); do
        case "$s" in
        main | direct) ;;
        *) uci -q delete "netshift.$s" ;;
        esac
    done
    uci -q delete netshift.main
    uci -q delete netshift.direct
    for opt in dns_pool_server dns_pool_mode dns_forward dns_server_route dns_via_outbound dns_outbound_section; do
        uci -q delete "netshift.settings.$opt"
    done

    profile | uci -q batch
    for url in $subs; do
        uci add_list netshift.main.subscription_url="$url"
    done
    uci set netshift.settings.postq_profile='1'
else
    profile | missing_only | uci -q batch
fi

# X-Ver-OS: the firmware version like the PostQ XKeen panel sends (OpenWrt
# "24.10.8"), not the kernel. Follows the firmware on every install.
# shellcheck disable=SC1091
release="$(. /etc/openwrt_release 2>/dev/null && printf '%s' "$DISTRIB_RELEASE")"
[ -n "$release" ] && uci set netshift.main.subscription_os_version="$release"

# The direct section must come first in the file so that its rules win
uci reorder netshift.direct=1
uci reorder netshift.main=2
uci commit netshift

exit 0
