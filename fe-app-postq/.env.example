SFTP_HOST=192.168.160.129
SFTP_PORT=22
SFTP_USER=root
SFTP_PASS=

# you can use key if needed
# SFTP_PRIVATE_KEY=~/.ssh/id_rsa

LOCAL_DIR_FE=../luci-app-postq/htdocs/luci-static/resources/view/postq
# The installed PACKAGE keeps the views in a content-hashed directory
# (view/postq_<hash>/, see luci-app-postq/cache-bust.sh) so a browser cannot
# serve the previous version's JS after an update, and its requires and menu path
# point there. Uploading the source tree to view/postq/ therefore only shows
# up on a router where the menu still opens view/postq (no package installed,
# or a dev build without cache-bust). With a package installed, upload to that
# hashed directory instead - but the uploaded files still say `view.postq.*`
# in their requires, so run sed on them once (or install a dev package). Such
# uploaded files are replaced by the next package update:
#   sed -i 's/view\.postq\./view.postq_<hash>./g' /www/.../view/postq_<hash>/*.js
# The hash of the installed package:
#   ls /www/luci-static/resources/view | grep '^postq_'
REMOTE_DIR_FE=/www/luci-static/resources/view/postq

LOCAL_DIR_BIN=../postq/files/usr/bin/
REMOTE_DIR_BIN=/usr/bin/

LOCAL_DIR_LIB=../postq/files/usr/lib/
REMOTE_DIR_LIB=/usr/lib/postq/
