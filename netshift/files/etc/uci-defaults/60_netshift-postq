#!/bin/sh
# PostQ profile: the routing and DNS PostQ ships with.
#
# The first install sets it whole: the sections of another setup are removed and
# every value below is set (the subscription URLs found are kept). The device
# gets settings.postq_profile '1'. Every later install or upgrade only adds what
# is missing: a value of the profile the config does not have yet (a new option
# of a later release); anything that is there, changed on the router or not
# (the DNS server picked on the Diagnostics tab, an edit with uci), is kept.

CONFIG=/etc/config/netshift
[ -f "$CONFIG" ] || exit 0

