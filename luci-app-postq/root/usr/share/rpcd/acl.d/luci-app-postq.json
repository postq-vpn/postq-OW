{
  "luci-app-postq": {
    "description": "Grant UCI and RPC access to LuCI app PostQ VPN",
    "read": {
      "file": {
        "/etc/init.d/postq": [
          "exec"
        ],
        "/usr/bin/postq": [
          "exec"
        ],
        "/proc/stat": [
          "read"
        ]
      },
      "ubus": {
        "service": [
          "list"
        ],
        "luci-rpc": [
          "getHostHints"
        ],
        "system": [
          "board",
          "info"
        ]
      },
      "uci": [
        "postq"
      ]
    },
    "write": {
      "file": {
        "/usr/libexec/postq-lan-ipv6": ["exec"]
      },
      "uci": [
        "postq"
      ]
    }
  }
}
